/*
 * FIO · authenticated shell
 *
 * Matrix/Element remains the substrate. This layer owns the domestic,
 * sovereign surface of the PULSO communication instrument.
 */

:root {
    --fio-background: #0f0f0f;
    --fio-background-deep: #0b0b0b;
    --fio-panel: #111110;
    --fio-foreground: #fbf9f5;
    --fio-carmine: #b8283e;
    --fio-muted: rgb(251 249 245 / 42%);
    --fio-faint: rgb(251 249 245 / 24%);
    --fio-hairline: rgb(251 249 245 / 11%);
    --fio-hairline-strong: rgb(251 249 245 / 18%);
}

.mx_MatrixChat {
    color: var(--fio-foreground);
    background: var(--fio-background);
    font-family:
        Inter,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;
}

.mx_MatrixChat_wrapper {
    background: radial-gradient(circle at 72% 42%, rgb(251 249 245 / 2.5%), transparent 31%), var(--fio-background);
}

.mx_LeftPanel,
.mx_RoomListPanel,
.mx_SpacePanel,
.mx_LeftPanel .mx_LeftPanel_roomListContainer {
    background: rgb(15 15 15 / 96%);
}

.mx_SpacePanel {
    border-right: 1px solid var(--fio-hairline);
}

.mx_LeftPanel_roomListContainer {
    border-right: 1px solid var(--fio-hairline);
}

.mx_LeftPanel .mx_SearchBox,
.mx_LeftPanel .mx_RoomListHeader {
    border-bottom-color: var(--fio-hairline);
}

.mx_SpacePanel .mx_SpaceButton,
.mx_LeftPanel .mx_AccessibleButton,
.mx_LeftPanel button {
    color: var(--fio-muted);
}

.mx_SpacePanel .mx_SpaceButton_active .mx_SpaceButton_selectionWrapper {
    background: transparent !important;
    box-shadow: inset 2px 0 0 var(--fio-carmine);
}

.mx_SpacePanel .mx_SpaceButton_icon,
.mx_SpacePanel .mx_BaseAvatar,
.mx_LeftPanel .mx_BaseAvatar {
    filter: grayscale(1) saturate(0.2);
}

.mx_RoomListPanel [role="listbox"] {
    gap: 0 !important;
    padding: 0 14px 18px;
    border-bottom: 1px solid var(--fio-hairline);
}

.mx_RoomListPanel [role="listbox"] button {
    min-height: 30px;
    padding: 0 12px;
    color: var(--fio-muted);
    border: 0;
    border-right: 1px solid var(--fio-hairline);
    border-radius: 0;
    background: transparent;
    font-size: 9px;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: lowercase;
}

.mx_RoomListPanel [role="listbox"] button:hover,
.mx_RoomListPanel [role="listbox"] button[aria-selected="true"] {
    color: var(--fio-foreground);
    background: linear-gradient(180deg, transparent, rgb(184 40 62 / 7%));
    box-shadow: inset 0 -1px 0 rgb(184 40 62 / 62%);
}

.mx_UserMenu [role="menu"],
.mx_UserMenu + [role="menu"] {
    border-radius: 0;
    background: rgb(15 15 15 / 98%);
}

.mx_RoomView,
.mx_RoomView_body,
.mx_RoomView_timeline,
.mx_RoomView_MessageList,
.mx_MainSplit,
.mx_MainSplitContent {
    background: transparent;
}

.mx_RoomHeader {
    border-bottom: 1px solid var(--fio-hairline);
    background: rgb(15 15 15 / 88%);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
}

.mx_RoomHeader_name,
.mx_RoomHeader_heading,
.mx_RoomHeader h1 {
    color: var(--fio-foreground);
    font-family: Outfit, Inter, system-ui, sans-serif;
    font-weight: 300;
    letter-spacing: 0.08em;
}

.mx_RoomHeader_topic,
.mx_RoomHeader_subtitle {
    color: var(--fio-muted);
}

.mx_MessageComposer,
.mx_BasicMessageComposer,
.mx_SendMessageComposer {
    background: transparent;
}

.mx_MessageComposer_wrapper,
.mx_BasicMessageComposer_input,
.mx_SendMessageComposer .mx_BasicMessageComposer_input {
    border-color: var(--fio-hairline-strong);
    border-radius: 0;
    color: var(--fio-foreground);
    background: rgb(15 15 15 / 82%);
    box-shadow: none;
}

.mx_MessageComposer_wrapper:focus-within,
.mx_BasicMessageComposer_input:focus-within {
    border-color: rgb(251 249 245 / 42%);
    box-shadow: 0 12px 42px rgb(0 0 0 / 28%);
}

.mx_EventTile .mx_EventTile_body,
.mx_EventTile .mx_MTextBody {
    color: rgb(251 249 245 / 84%);
}

.mx_EventTile .mx_DisambiguatedProfile_displayName,
.mx_EventTile .mx_SenderProfile_name {
    color: var(--fio-foreground);
}

/* The instrument owns every surface, including overlays rendered outside MatrixChat. */
.mx_Dialog_wrapper,
.mx_ContextualMenu,
[role="menu"] {
    color: var(--fio-foreground);
}

.mx_Dialog_background {
    background: rgb(4 4 4 / 78%);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
}

.mx_Dialog,
.mx_ContextualMenu,
[role="menu"] {
    border: 1px solid var(--fio-hairline-strong);
    border-radius: 0;
    background: rgb(15 15 15 / 97%);
    box-shadow: 0 28px 100px rgb(0 0 0 / 52%);
}

.mx_Dialog_title,
.mx_Dialog h1,
.mx_Dialog h2,
.mx_Dialog h3 {
    color: var(--fio-foreground);
    font-family: Outfit, Inter, system-ui, sans-serif;
    font-weight: 300;
    letter-spacing: 0.04em;
}

.mx_Dialog p,
.mx_Dialog label,
.mx_Dialog .mx_SettingsTab_subheading,
.mx_Dialog .mx_SettingsTab_subsectionText {
    color: var(--fio-muted);
}

.mx_Dialog input,
.mx_Dialog textarea,
.mx_Dialog select,
.mx_Field,
.mx_Field input,
.mx_Field textarea,
.mx_Field select {
    color: var(--fio-foreground);
    border-color: var(--fio-hairline-strong);
    border-radius: 0;
    background: rgb(251 249 245 / 2%);
    box-shadow: none;
}

.mx_Field:focus-within,
.mx_Dialog input:focus,
.mx_Dialog textarea:focus,
.mx_Dialog select:focus {
    border-color: rgb(251 249 245 / 46%);
    box-shadow: 0 1px 0 rgb(184 40 62 / 58%);
    outline: none;
}

.mx_Dialog button,
.mx_Dialog [role="button"],
.mx_ContextualMenu button,
.mx_ContextualMenu [role="button"] {
    border-radius: 0;
    font-weight: 400;
    transition:
        color 180ms ease,
        background 180ms ease,
        border-color 180ms ease;
}

.mx_Dialog button:hover,
.mx_Dialog [role="button"]:hover,
.mx_ContextualMenu button:hover,
.mx_ContextualMenu [role="button"]:hover {
    background: linear-gradient(90deg, rgb(184 40 62 / 8%), transparent 76%);
}

.fio_RoomPreviewBar_invite {
    position: relative;
    width: min(620px, calc(100vw - 40px));
    padding: 52px 48px;
    border: 0;
    border-top: 1px solid var(--fio-hairline-strong);
    border-bottom: 1px solid var(--fio-hairline-strong);
    border-radius: 0;
    background: transparent;
}

.fio_RoomPreviewBar_invite::before {
    content: "[ LIMIAR ]";
    margin-bottom: 38px;
    color: var(--fio-muted);
    font-size: 9px;
    letter-spacing: 0.28em;
}

.fio_RoomPreviewBar_invite h3 {
    margin-bottom: 36px;
    color: var(--fio-foreground);
    font-family: Outfit, Inter, system-ui, sans-serif;
    font-size: clamp(28px, 4vw, 46px);
    font-weight: 200;
    line-height: 1.08;
    letter-spacing: -0.025em;
}

.fio_RoomPreviewBar_invite .mx_RoomPreviewBar_message p {
    color: var(--fio-muted);
    font-size: 12px;
    line-height: 1.8;
}

.fio_RoomPreviewBar_invite .mx_RoomPreviewBar_actions {
    width: min(100%, 420px);
    margin-top: 28px;
}

.fio_RoomPreviewBar_invite .mx_AccessibleButton,
.fio_RoomPreviewBar_invite button {
    min-height: 48px;
    border-bottom: 1px solid var(--fio-hairline);
    background: transparent;
}

.fio_RoomPreviewBar_invite .mx_AccessibleButton_kind_primary {
    color: var(--fio-foreground);
    border-color: rgb(184 40 62 / 55%);
    background: linear-gradient(90deg, rgb(184 40 62 / 12%), transparent 72%);
}

.fio_UserSettingsDialog.mx_Dialog {
    width: min(1120px, calc(100vw - 48px));
    max-width: none;
    height: min(780px, calc(100dvh - 48px));
    padding: 32px 34px 28px;
}

.fio_UserSettingsDialog .mx_UserSettingsDialog_title {
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
}

.fio_UserSettingsDialog .mx_TabbedView {
    top: 82px;
    padding-left: 0;
}

.fio_UserSettingsDialog .mx_TabbedView_tabsOnLeft .mx_TabbedView_tabLabels {
    width: 210px;
    max-width: 210px;
    padding-top: 12px;
    border-right: 1px solid var(--fio-hairline);
}

.fio_UserSettingsDialog .mx_TabbedView_tabsOnLeft .mx_TabbedView_tabPanel {
    margin-left: 252px;
}

.fio_UserSettingsDialog .mx_TabbedView_tabLabel {
    min-height: 48px;
    padding: 12px 18px;
    color: var(--fio-muted);
    border-radius: 0;
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: lowercase;
}

.fio_UserSettingsDialog .mx_TabbedView_tabLabel:hover {
    color: var(--fio-foreground);
    background: linear-gradient(90deg, rgb(251 249 245 / 4%), transparent 76%);
}

.fio_UserSettingsDialog .mx_TabbedView_tabLabel_active {
    color: var(--fio-foreground);
    outline: 0;
    background: linear-gradient(90deg, rgb(184 40 62 / 10%), transparent 78%);
    box-shadow: inset 1px 0 0 var(--fio-carmine);
}

.fio_UserSettingsDialog .mx_TabbedView_tabLabel svg {
    color: var(--fio-faint);
}

.fio_UserSettingsDialog .mx_SettingsTab {
    max-width: 720px;
    padding-right: 48px;
}

.fio_UserSettingsDialog .mx_SettingsTab h2,
.fio_UserSettingsDialog .mx_SettingsTab h3 {
    padding-bottom: 14px;
    border-bottom: 1px solid var(--fio-hairline);
}

.mx_QuickSettingsButton_ContextMenuWrapper .mx_ContextualMenu,
.mx_ThreadsActivityCentre_container [role="menu"] {
    min-width: 280px;
    padding: 18px;
}

.mx_QuickSettingsButton_ContextMenuWrapper h2,
.mx_ThreadsActivityCentre_container [role="menu"] > [role="heading"] {
    color: var(--fio-muted);
    font-size: 9px;
    font-weight: 400;
    letter-spacing: 0.22em;
    text-transform: uppercase;
}

.mx_ThreadsActivityCentre_emptyCaption {
    padding: 34px 20px;
    color: var(--fio-muted);
    font-size: 12px;
    line-height: 1.7;
}

.mx_ToastContainer .mx_Toast_toast {
    border: 1px solid var(--fio-hairline-strong);
    border-radius: 0;
    color: var(--fio-foreground);
    background: rgb(15 15 15 / 98%);
    box-shadow: 0 22px 70px rgb(0 0 0 / 48%);
}

.mx_ToastContainer .mx_Toast_title {
    font-family: Outfit, Inter, system-ui, sans-serif;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.08em;
}

.mx_ToastContainer .mx_Toast_description {
    color: var(--fio-muted);
    font-size: 11px;
    line-height: 1.65;
}

@media (max-width: 760px) {
    .fio_RoomPreviewBar_invite {
        width: calc(100vw - 32px);
        padding: 38px 18px;
    }

    .fio_UserSettingsDialog.mx_Dialog {
        width: calc(100vw - 16px);
        height: calc(100dvh - 16px);
        padding: 22px 16px 16px;
    }

    .fio_UserSettingsDialog .mx_TabbedView_tabsOnLeft .mx_TabbedView_tabPanel {
        margin-left: 56px;
    }

    .fio_UserSettingsDialog .mx_TabbedView_tabsOnLeft .mx_TabbedView_tabLabels {
        width: 44px;
    }

    .fio_UserSettingsDialog .mx_SettingsTab {
        min-width: 0;
        padding-right: 12px;
    }
}

.mx_HomePage.mx_HomePage_default {
    display: block;
    width: 100%;
    max-width: none;
    margin: 0;
    text-align: left;
    background: transparent;
}

.fio_Home {
    position: relative;
    box-sizing: border-box;
    display: grid;
    grid-template-rows: auto 1fr auto;
    width: 100%;
    min-height: 100%;
    padding: 28px 34px 24px;
    overflow: hidden;
    color: var(--fio-foreground);
    background:
        linear-gradient(90deg, transparent 49.95%, rgb(251 249 245 / 3.5%) 50%, transparent 50.05%),
        linear-gradient(0deg, transparent 49.95%, rgb(251 249 245 / 2.4%) 50%, transparent 50.05%);
}

.fio_Home::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.12;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.12'/%3E%3C/svg%3E");
    mix-blend-mode: soft-light;
}

.fio_HomeHeader,
.fio_HomeFooter {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 18px;
    color: var(--fio-muted);
    font-size: 9px;
    font-weight: 300;
    letter-spacing: 0.24em;
    text-transform: lowercase;
}

.fio_HomeMark {
    color: rgb(251 249 245 / 68%);
}

.fio_HomeLine {
    width: 58px;
    height: 1px;
    background: var(--fio-hairline-strong);
}

.fio_HomeStatus {
    margin-left: auto;
}

.fio_HomeBody {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(280px, 1fr) minmax(330px, 0.82fr);
    align-items: center;
    gap: clamp(60px, 9vw, 160px);
    width: min(100%, 1120px);
    margin: 0 auto;
}

.fio_HomeEyebrow {
    display: block;
    margin-bottom: 34px;
    color: var(--fio-muted);
    font-size: 9px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
}

.fio_HomeIdentity h1 {
    max-width: 560px;
    margin: 0;
    color: var(--fio-foreground);
    font-family: Outfit, Inter, system-ui, sans-serif;
    font-size: clamp(42px, 5.4vw, 78px);
    font-weight: 200;
    line-height: 0.98;
    letter-spacing: -0.04em;
}

.fio_HomeIdentity p {
    margin: 34px 0 0;
    color: var(--fio-muted);
    font-size: 13px;
    font-weight: 300;
    line-height: 1.75;
}

.fio_HomeActions {
    border-top: 1px solid var(--fio-hairline);
}

.fio_HomeAction.mx_AccessibleButton {
    display: grid;
    grid-template-columns: 28px 1fr auto;
    align-items: center;
    gap: 20px;
    width: 100%;
    min-height: 108px;
    padding: 20px 8px;
    border-bottom: 1px solid var(--fio-hairline);
    color: var(--fio-muted);
    transition:
        color 220ms ease,
        padding 260ms ease,
        border-color 220ms ease;
}

.fio_HomeAction.mx_AccessibleButton:hover,
.fio_HomeAction.mx_AccessibleButton:focus-visible {
    padding-right: 0;
    padding-left: 18px;
    color: var(--fio-foreground);
    border-color: rgb(184 40 62 / 54%);
    background: linear-gradient(90deg, rgb(184 40 62 / 7%), transparent 68%);
    outline: none;
}

.fio_HomeActionGlyph {
    color: rgb(251 249 245 / 48%);
    font-family: Outfit, Inter, system-ui, sans-serif;
    font-size: 22px;
    font-weight: 200;
}

.fio_HomeAction strong,
.fio_HomeAction small {
    display: block;
    font-weight: 300;
}

.fio_HomeAction strong {
    color: var(--fio-foreground);
    font-family: Outfit, Inter, system-ui, sans-serif;
    font-size: 16px;
    letter-spacing: 0.08em;
}

.fio_HomeAction small {
    margin-top: 8px;
    color: var(--fio-muted);
    font-size: 9px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
}

.fio_HomeActionArrow {
    color: var(--fio-faint);
    font-size: 17px;
}

.fio_HomeFooter {
    justify-content: space-between;
    padding-top: 18px;
    border-top: 1px solid var(--fio-hairline);
}

@media (max-width: 760px) {
    .fio_Home {
        min-height: 100dvh;
        padding: 22px 20px 18px;
    }

    .fio_HomeHeader {
        align-items: flex-start;
    }

    .fio_HomeLine {
        display: none;
    }

    .fio_HomeStatus {
        max-width: 130px;
        line-height: 1.8;
        text-align: right;
    }

    .fio_HomeBody {
        grid-template-columns: 1fr;
        align-content: center;
        gap: 52px;
        padding: 54px 0;
    }

    .fio_HomeEyebrow {
        margin-bottom: 22px;
    }

    .fio_HomeIdentity h1 {
        max-width: 320px;
        font-size: clamp(42px, 14vw, 60px);
    }

    .fio_HomeIdentity p {
        margin-top: 24px;
        font-size: 12px;
    }

    .fio_HomeIdentity br {
        display: none;
    }

    .fio_HomeAction.mx_AccessibleButton {
        min-height: 92px;
    }

    .fio_HomeFooter {
        align-items: flex-end;
        gap: 28px;
        line-height: 1.6;
    }

    .fio_HomeFooter span:last-child {
        max-width: 170px;
        text-align: right;
    }
}

@media (prefers-reduced-motion: reduce) {
    .fio_HomeAction.mx_AccessibleButton {
        transition: none;
    }
}
